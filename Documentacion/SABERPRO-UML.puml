clsAppController ..|> IAppController
clsAppController --> "1" IServiceUser : attIUserService
clsAppController --> "1" IserviceAdministrator : attIAdministratorService
clsAppController --> "1" IServiceQuestion : attIQuestionService
clsAppController ..> rpsUser
clsAppController ..> rpsQuestion
clsServiceUser ..|> IServiceUser
clsServiceAdministrator ..|> IserviceAdministrator
clsServicesQuestion ..|> IServiceQuestion
clsServiceSecurity ..|> IServiceSecurity
clsServiceUser --> "1" IServiceSecurity : attServiceSecurity
clsServiceAdministrator --> "1" IServiceSecurity : attServiceSecurity
clsServiceUser --> "1" IRepositoryUser : attRepositoryUser
clsServiceAdministrator --> "1" IRepositoryUser : attRepositoryUser
clsServicesQuestion --> "1" clsMicroKernel : attMicroKernel
clsServicesQuestion --> "1" IRepositoryQuestion : attRepositoryQuestion
clsServicesQuestion ..> clsValidatorQuestion
clsMicroKernel --> "1" clsPluginManager : attPluginManager
clsMicroKernel --> "1" IRepositoryQuestion : attRepositoryQuestion
clsPluginManager --> "1" clsPluginRegistry : attRegistry
clsPluginManager ..> IQuestionPlugin
clsPluginRegistry --> "*" IQuestionPlugin : attPlugins
plgMultipleChoice ..|> IQuestionPlugin
IQuestionPlugin ..> clsQuestion
IRepositoryUser --|> JpaRepository
IRepositoryQuestion --|> JpaRepository
IRepositoryUser ..> clsUser
IRepositoryQuestion ..> clsQuestion
clsQuestion "*" --> "1" clsUser : attAuthor
clsQuestion "*" --> "0..2" clsUser : attReviewer1 / attReviewer2
clsQuestion --> "1" EnumStatus : attStatus
clsQuestion --> "1" EnumDificulty : attDificulty
clsUser --> "1" EnumRole : attRole
IServiceUser ..> rqtValidateUser
IServiceUser ..> rpsValidateUser
IServiceUser ..> rqtStudent
IserviceAdministrator ..> rqtUser
IServiceQuestion ..> rqtQuestion
IServiceQuestion ..> rqtUpdateQuestion
IServiceQuestion ..> rqtAssignReviewer
IServiceQuestion ..> rqtChangeStatus
